{
  "crons": [
    { "path": "/api/downtown-u/jobs/expire-reservations", "schedule": "*/5 * * * *" }
  ],
  "rewrites": [
    { "source": "/api/catalog", "destination": "/api/catalog" },
    { "source": "/api/create-order", "destination": "/api/create-order" },
    { "source": "/api/validate-promo", "destination": "/api/validate-promo" },
    { "source": "/api/downtown-u/square-webhook", "destination": "/api/downtown-u/square-webhook" },
    { "source": "/api/downtown-u/checkout-config", "destination": "/api/downtown-u/checkout-config" },
    { "source": "/api/downtown-u/checkout", "destination": "/api/downtown-u/checkout" },
    { "source": "/api/downtown-u/request-link", "destination": "/api/downtown-u/request-link" },
    { "source": "/api/downtown-u/send-code", "destination": "/api/downtown-u/send-code" },
    { "source": "/api/downtown-u/verify-code", "destination": "/api/downtown-u/verify-code" },
    { "source": "/api/downtown-u/me", "destination": "/api/downtown-u/me" },
    { "source": "/api/downtown-u/meals", "destination": "/api/downtown-u/meals" },
    { "source": "/api/downtown-u/purchases", "destination": "/api/downtown-u/purchases" },
    { "source": "/api/downtown-u/reservations", "destination": "/api/downtown-u/reservations" },
    { "source": "/api/downtown-u/reservations/:id/cancel", "destination": "/api/downtown-u/reservations/:id/cancel" },
    { "source": "/api/downtown-u/logout", "destination": "/api/downtown-u/logout" },
    { "source": "/api/downtown-u/jobs/expire-reservations", "destination": "/api/downtown-u/jobs/expire-reservations" },
    { "source": "/downtown-u/auth/verify", "destination": "/downtown-u-auth-verify.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-XRgsly8MlOiUFyfzlksx7S15DKj5ZwsBK2cIo5KgxV8=' 'sha256-IybXeQrrNW5v7KWZonuD5IwNJI5g69VaO3WKIbHj7pI=' https://web.squarecdn.com; connect-src 'self' https://web.squarecdn.com https://pci-connect.squareup.com; frame-src https://web.squarecdn.com; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://web.squarecdn.com\")" }
      ]
    },
    {
      "source": "/downtown-u/auth/verify",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; connect-src 'self'; script-src 'sha256-C1oBHV+xnT9+lpmb9T6VNHESeHcD4MO0QKzDM+vIIJY='; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" }
      ]
    }
  ]
}

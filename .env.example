# Public URLs only — never put a Square access token or other secret in VITE_*.
# Configure all four or Downtown U checkout fails closed. Each must be a reusable
# Square Payment Link for the exact plan/price, configured in Square to collect
# buyer name, email, and phone. Verify each link in Square before deployment.
VITE_DOWNTOWN_U_FLEX_5_URL=
VITE_DOWNTOWN_U_SCHOLAR_10_URL=
VITE_DOWNTOWN_U_RESIDENT_20_URL=
VITE_DOWNTOWN_U_SEMESTER_40_URL=

# Server-only runtime login. Its database login must be a member of the
# NOLOGIN downtown_u_runtime group created by the migration. Never use the
# migration owner here, prefix either URL with VITE_, or log either value.
DATABASE_URL=postgresql://RUNTIME_USER:RUNTIME_PASSWORD@HOST:5432/DATABASE?sslmode=require

# Deployment/migration jobs only. This separate owner credential must be able
# to create roles and own DDL; it must never be available to the web runtime.
MIGRATION_DATABASE_URL=postgresql://MIGRATION_OWNER:MIGRATION_PASSWORD@HOST:5432/DATABASE?sslmode=require

# Server-only Square webhook/runtime configuration. The webhook URL must be the
# exact public notification URL registered in Square. Never prefix these with
# VITE_, expose them to browser code, or log their values.
SQUARE_WEBHOOK_SIGNATURE_KEY=
DOWNTOWN_U_SQUARE_WEBHOOK_URL=
SQUARE_API_VERSION=
SQUARE_LOCATION_ID=

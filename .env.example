# Embedded checkout has no VITE_* Square values. The fixed, gated config endpoint
# exposes only this public application ID and the fixed Proper location ID.
# Never put SQUARE_ACCESS_TOKEN or catalog variation IDs in VITE_*.
DOWNTOWN_U_SQUARE_APPLICATION_ID=
DOWNTOWN_U_CHECKOUT_ENABLED=0

# Server-only runtime login. DATABASE_URL must authenticate directly as a
# dedicated LOGIN whose only role membership is the NOLOGIN downtown_u_runtime
# group created by the migration. Never use the migration owner, an admin/general
# credential, or connection options=-c role=...; never prefix either URL with
# VITE_ or log either value.
DATABASE_URL=postgresql://RUNTIME_USER:RUNTIME_PASSWORD@HOST:5432/DATABASE?sslmode=require

# Deployment/migration jobs only. This separate owner credential must be able
# to create roles and own DDL; it must never be available to the web runtime.
MIGRATION_DATABASE_URL=postgresql://MIGRATION_OWNER:MIGRATION_PASSWORD@HOST:5432/DATABASE?sslmode=require

# Server-only Square webhook/runtime configuration. The webhook URL must be the
# exact public notification URL registered in Square. Never prefix these with
# VITE_, expose them to browser code, or log their values.
SQUARE_WEBHOOK_SIGNATURE_KEY=
DOWNTOWN_U_SQUARE_WEBHOOK_URL=
SQUARE_API_VERSION=2026-01-22
SQUARE_LOCATION_ID=LPPWSSV03BHK8
SQUARE_ACCESS_TOKEN=

# Server-only authoritative Downtown U catalog variation IDs. Configure all four
# as unique Square catalog variation IDs; never expose them through VITE_*.
DOWNTOWN_U_SQUARE_FLEX_5_VARIATION_ID=
DOWNTOWN_U_SQUARE_SCHOLAR_10_VARIATION_ID=
DOWNTOWN_U_SQUARE_RESIDENT_20_VARIATION_ID=
DOWNTOWN_U_SQUARE_SEMESTER_40_VARIATION_ID=

# Server-only dedicated authentication HMAC key: exactly 32 random bytes encoded
# as canonical unpadded base64url. Generate with:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Generate independently from database/Square/provider secrets; never prefix VITE_ or log it.
DOWNTOWN_U_AUTH_SECRET=

# Server-only Downtown U delivery configuration. The public origin is an exact
# allowlisted HTTPS origin (no path/query) used for CSRF checks and magic links;
# Host/X-Forwarded-Host are never trusted. Provider timeout is optional (100-30000ms).
DOWNTOWN_U_PUBLIC_APP_ORIGIN=https://example.com
DOWNTOWN_U_AUTH_EMAIL_FROM=Downtown U <signin@example.com>
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
DOWNTOWN_U_AUTH_SMS_FROM=
DOWNTOWN_U_AUTH_PROVIDER_TIMEOUT_MS=5000

# Server-only portal deployment gate. Keep 0 until meal mappings are approved and
# the five-minute expiry schedule plus generic success/failure monitoring are
# verified. Production portal handlers and the expiry job enable only on exact 1.
DOWNTOWN_U_PORTAL_ENABLED=0

# Protected reservation-expiry job. It requires a separate LOGIN whose only role
# membership is the NOLOGIN downtown_u_jobs group; never reuse DATABASE_URL. Vercel
# cron sends GET every five minutes with `Authorization: Bearer $CRON_SECRET`.
# CRON_SECRET is preferred; DOWNTOWN_U_JOBS_SECRET is a compatibility fallback only
# when CRON_SECRET is absent. Each is exactly 32 random bytes encoded as canonical
# unpadded base64url. Monitor generic status/count logs and alert on 503 or backlog.
DOWNTOWN_U_JOBS_DATABASE_URL=postgresql://JOBS_USER:JOBS_PASSWORD@HOST:5432/DATABASE?sslmode=require
CRON_SECRET=
DOWNTOWN_U_JOBS_SECRET=

# Server-only Square kitchen-order worker. This URL must authenticate as a
# separate LOGIN whose only membership is the NOLOGIN downtown_u_kitchen_jobs
# role; never reuse DATABASE_URL, the expiry-job login, or the migration owner.
# Keep the deployment gate at 0 and downtown_u_kitchen_config.enabled=false until
# the trusted meal/modifier mappings, Square sandbox ticket, cron, and alerts are
# verified. The worker uses stable idempotency keys and submits no buyer PII.
DOWNTOWN_U_KITCHEN_ORDERS_ENABLED=0
DOWNTOWN_U_KITCHEN_DATABASE_URL=postgresql://KITCHEN_USER:KITCHEN_PASSWORD@HOST:5432/DATABASE?sslmode=require

# Server-only deployment-wide auth request admission. Use one dedicated Upstash
# Redis database for all production function instances. The URL must be the exact
# HTTPS *.upstash.io REST origin; token and URL must never use VITE_ or be logged.
# Production request-link/send-code fail closed unless VERCEL=1 and both exist.
UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=
